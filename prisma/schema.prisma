// Fuel Station Manager — database schema (Microsoft SQL Server production/dev)
//
// Money and volume are stored as fixed-point Decimal, never
// float, so totals reconcile exactly. Every mutation that touches stock, cash,
// or credit balances happens inside a DB transaction (see src/lib/actions/*)
// and is mirrored into AuditLog for traceability.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

/// A platform operator — the people who run this SaaS, not the people who run
/// a petrol pump.
model PlatformAdmin {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String?
  name         String
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions  PlatformSession[]
  auditLogs PlatformAuditLog[]
}

/// Sessions for the platform plane.
model PlatformSession {
  id        String        @id @default(cuid())
  adminId   String
  admin     PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt DateTime      @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?

  @@index([adminId])
}

/// Append-only trail of operator actions.
model PlatformAuditLog {
  id         String         @id @default(cuid())
  actorId    String?
  actor      PlatformAdmin? @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  action     String
  entityType String
  entityId   String
  metadata   String?        @db.NVarChar(Max)
  createdAt  DateTime       @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

/// Multi-Tenant Station Registry for Master Database.
model Tenant {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  companyName     String?
  databaseName    String    @unique
  databaseServer  String    @default("localhost:1435")
  status          String    @default("ACTIVE") // ACTIVE, SUSPENDED
  phone           String?
  email           String?
  address         String
  suspendedAt     DateTime?
  suspendedReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
}

model Station {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  companyName     String?
  phone           String?
  email           String?
  address         String
  suspendedAt     DateTime?
  suspendedReason String?
  createdAt       DateTime  @default(now())
  nextReceiptNo   Int       @default(1)

  users     User[]
  tanks     Tank[]
  customers Customer[]
  sales     Sale[]
  purchases Purchase[]
  auditLogs AuditLog[]
}

model User {
  id             String    @id @default(cuid())
  stationId      String
  station        Station   @relation(fields: [stationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name           String
  username       String
  email          String?
  phone          String?
  employeeId     String?
  passwordHash   String
  role           String    // OWNER, MANAGER, CASHIER, ACCOUNTANT, ATTENDANT, OTHER
  permissions    String?   @db.NVarChar(Max)
  active         Boolean   @default(true)
  onShift        Boolean   @default(false)
  shiftStartedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions         Session[]
  sales            Sale[]
  purchases        Purchase[]        @relation("PurchaseRecordedBy")
  payments         CustomerPayment[] @relation("PaymentRecordedBy")
  rateChanges      FuelRateHistory[] @relation("RateChangedBy")
  auditLogs        AuditLog[]
  shifts           Shift[]
  endedShiftsAdmin Shift[]           @relation("ShiftEndedBy")

  @@unique([stationId, username])
  @@index([stationId])
}

/// Server-side session record.
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?

  @@index([userId])
}

model Tank {
  id          String   @id @default(cuid())
  stationId   String
  station     Station  @relation(fields: [stationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fuel        String   // PETROL, DIESEL, CNG
  capacityL   Decimal  @db.Decimal(12, 3)
  levelL      Decimal  @db.Decimal(12, 3)
  openingL    Decimal  @db.Decimal(12, 3)
  ratePerL    Decimal  @db.Decimal(10, 2)
  lowStockPct Decimal  @default(20) @db.Decimal(5, 2)
  updatedAt   DateTime @updatedAt

  sales       Sale[]
  purchases   Purchase[]
  rateHistory FuelRateHistory[]

  @@unique([stationId, fuel])
}

model FuelRateHistory {
  id          String   @id @default(cuid())
  tankId      String
  tank        Tank     @relation(fields: [tankId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  oldRate     Decimal  @db.Decimal(10, 2)
  newRate     Decimal  @db.Decimal(10, 2)
  changedById String
  changedBy   User     @relation("RateChangedBy", fields: [changedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  changedAt   DateTime @default(now())

  @@index([tankId])
}

model Customer {
  id          String   @id @default(cuid())
  stationId   String
  station     Station  @relation(fields: [stationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name        String
  phone       String?
  creditLimit Decimal  @default(0) @db.Decimal(12, 2)
  dueAmount   Decimal  @default(0) @db.Decimal(12, 2)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  sales    Sale[]
  payments CustomerPayment[]

  @@index([stationId])
}

model Sale {
  id            String    @id @default(cuid())
  receiptNo     Int
  stationId     String
  station       Station   @relation(fields: [stationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tankId        String
  tank          Tank      @relation(fields: [tankId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fuel          String    // PETROL, DIESEL, CNG
  liters        Decimal   @db.Decimal(12, 3)
  ratePerL      Decimal   @db.Decimal(10, 2)
  totalAmount   Decimal   @db.Decimal(12, 2)
  paymentMethod String    // CASH, CREDIT
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  soldById      String
  soldBy        User      @relation(fields: [soldById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt     DateTime  @default(now())

  vehicleNo  String?
  voided     Boolean   @default(false)
  voidedAt   DateTime?
  voidReason String?

  @@unique([stationId, receiptNo])
  @@index([stationId, createdAt])
  @@index([customerId])
  @@index([stationId, vehicleNo])
}

model Purchase {
  id           String   @id @default(cuid())
  stationId    String
  station      Station  @relation(fields: [stationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tankId       String
  tank         Tank     @relation(fields: [tankId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fuel         String   // PETROL, DIESEL, CNG
  liters       Decimal  @db.Decimal(12, 3)
  totalCost    Decimal  @db.Decimal(12, 2)
  supplier     String
  invoiceNo    String?
  recordedById String
  recordedBy   User     @relation("PurchaseRecordedBy", fields: [recordedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt    DateTime @default(now())

  @@index([stationId, createdAt])
}

model CustomerPayment {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  amount       Decimal  @db.Decimal(12, 2)
  recordedById String
  recordedBy   User     @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt    DateTime @default(now())

  @@index([customerId])
}

model Shift {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  endedById String?
  endedBy   User?     @relation("ShiftEndedBy", fields: [endedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
}

/// Append-only trail for every state-changing action.
model AuditLog {
  id         String   @id @default(cuid())
  stationId  String
  station    Station  @relation(fields: [stationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  action     String
  entityType String
  entityId   String
  metadata   String?  @db.NVarChar(Max)
  createdAt  DateTime @default(now())

  @@index([stationId, createdAt])
  @@index([entityType, entityId])
}
